# =============================================================================
# ConvoLens Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=sqlite:///./convolens.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/convolens

# --- LLM Provider ---
# Set ONE of these depending on your provider
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Which LLM backend to use: "claude" or "openai"
LLM_PROVIDER=claude
# Model name
LLM_MODEL=claude-sonnet-4-20250514

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ASR / Transcription ---
DEEPGRAM_API_KEY=
WHISPER_MODEL_SIZE=base

# --- S3 / Object Storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=convolens-audio
AWS_REGION=ap-south-1

# --- App Settings ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- PII Masking ---
PII_MASKING_ENABLED=true

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
